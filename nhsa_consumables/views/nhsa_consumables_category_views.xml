<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="nhsa_consumables_category_list_view" model="ir.ui.view">
        <field name="name">nhsa.consumables.category.list</field>
        <field name="model">nhsa.consumables.category</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <tree string="医保医用耗材分类">
                <field name="display_name" string="医保医用耗材分类"/>
                <field name="code"/>
            </tree>
        </field>
    </record>

    <record id="nhsa_consumables_category_search_view" model="ir.ui.view">
        <field name="name">nhsa.consumables.category.search</field>
        <field name="model">nhsa.consumables.category</field>
        <field name="arch" type="xml">
            <search string="医保医用耗材分类">
                <field name="name" string="医保医用耗材分类"/>
                <field name="parent_id"/>
            </search>
        </field>
    </record>

    <record id="nhsa_consumables_category_action_form" model="ir.actions.act_window">
        <field name="name">医保医用耗材分类</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">nhsa.consumables.category</field>
    </record>

</odoo>
