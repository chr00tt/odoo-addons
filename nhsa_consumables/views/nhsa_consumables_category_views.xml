<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="nhsa_consumables_category_form_view" model="ir.ui.view">
        <field name="name">nhsa.consumables.category.form</field>
        <field name="model">nhsa.consumables.category</field>
        <field name="arch" type="xml">
            <form class="oe_form_configuration">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button"
                            name="%(nhsa_consumables_action)d"
                            icon="fa-th-list"
                            type="action"
                            context="{'search_default_nhsa_consumables_categ_id': active_id, 'default_nhsa_consumables_categ_id': active_id, 'group_expand': True}">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="nhsa_consumables_count"/></span>
                                <span class="o_stat_text"> 耗材</span>
                            </div>
                        </button>
                        <button class="oe_stat_button"
                            name="%(product.product_template_action_all)d"
                            icon="fa-th-list"
                            type="action"
                            context="{'search_default_nhsa_consumables_categ_id': active_id, 'default_nhsa_consumables_categ_id': active_id, 'group_expand': True}">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="product_count"/></span>
                                <span class="o_stat_text"> 产品</span>
                            </div>
                        </button>
                        <button class="oe_stat_button"
                            name="%(product.product_supplierinfo_type_action)d"
                            icon="fa-th-list"
                            type="action"
                            context="{'search_default_nhsa_consumables_categ_id': active_id, 'default_nhsa_consumables_categ_id': active_id, 'group_expand': True}">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="supplier_count"/></span>
                                <span class="o_stat_text"> 供应</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="分类"/>
                        <h1><field name="name" placeholder="e.g. Lamps"/></h1>
                    </div>
                    <group name="first" col="2">
                        <field name="parent_id" class="oe_inline"/>
                    </group>
                    <group>
                        <field name="code"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nhsa_consumables_category_list_view" model="ir.ui.view">
        <field name="name">nhsa.consumables.category.list</field>
        <field name="model">nhsa.consumables.category</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <tree string="医保医用耗材分类">
                <field name="display_name" string="医保医用耗材分类"/>
                <field name="code"/>
                <field name="nhsa_consumables_count" optional="hide"/>
                <field name="product_count" optional="hide"/>
                <field name="supplier_count" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="nhsa_consumables_category_search_view" model="ir.ui.view">
        <field name="name">nhsa.consumables.category.search</field>
        <field name="model">nhsa.consumables.category</field>
        <field name="arch" type="xml">
            <search string="医保医用耗材分类">
                <field name="name" string="医保医用耗材分类"/>
                <field name="parent_id"/>
            </search>
        </field>
    </record>

    <record id="nhsa_consumables_category_action_form" model="ir.actions.act_window">
        <field name="name">医保医用耗材分类</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">nhsa.consumables.category</field>
    </record>

</odoo>
