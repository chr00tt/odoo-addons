<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='medical_consumables']/group" position="inside">
                <group string="医保医用耗材分类">
                    <field name="nhsa_consumables_id"/>
                    <field name="nhsa_consumables_categ_id"/>
                    <field name="nhsa_common_name"/>
                    <field name="nhsa_material"/>
                    <field name="nhsa_specifications"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="product_template_search_view" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="nhsa_consumables_categ_id"/>
            </xpath>
        </field>
    </record>

</odoo>
