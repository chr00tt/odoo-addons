<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record id="view_picking_form" model="ir.ui.view">
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='move_ids_without_package']/tree/field[@name='product_id']" position="after">
                    <field name="product_ggxh" optional="hide"/>
                    <field name="registration_number" optional="hide"/>
                    <field name="product_tag_ids" optional="hide" widget="many2many_tags"/>
                    <field name="manufacturer_id" optional="hide"/>
                    <field name="categ_id" optional="hide"/>
                    <field name="product_ybbm" optional="hide"/>
                </xpath>
            </field>
        </record>

</odoo>
