<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_tree_view" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view" />
        <field name="arch" type="xml">
            <field name="default_code" position="after">
                <field name="ggxh" optional="hide"/>
                <field name="ybbm" optional="hide"/>
                <field name="product_origin" optional="hide"/>
                <field name="purchase_style" column_invisible="1"/>
            </field>
        </field>
    </record>
     <!-- 继承看板视图 -->
    <record id="product_template_kanban_view" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view" />
        <field name="arch" type="xml">
            <!-- 在看板视图中添加 purchase_style 字段 -->
            <xpath expr="//kanban" position="inside">
                 <field name="purchase_style" column_invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_kanban_view" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//t[@t-if='record.default_code.value']" position="after">
                <t t-if="record.ggxh.value">(<field name="ggxh"/>)</t>
            </xpath>
        </field>
    </record>

    <record id="product_view_kanban_catalog" model="ir.ui.view">
        <field name="name">industry_fsm.product.catalog.kanban.view.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_view_kanban_catalog"/>
        <!-- make sure it's bigger than existing catalog view -->
        <field name="arch" type="xml">
            <xpath expr="//div[@t-if='record.default_code.value']" position="after">
                <div t-if="record.ggxh.value">
                            (<field name="ggxh"/>)
                </div>
            </xpath>
        </field>
    </record>
</odoo>
