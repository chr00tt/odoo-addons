<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <div name="options" position="inside">
                <field name="is_medical_consumables"/>
                <label for="is_medical_consumables"/>
            </div>
            <field name="uom_id" position="before">
                <field name="ggxh"/>
            </field>
            <xpath expr="//notebook" position="inside">
                <page string="医用耗材" name="medical_consumables" invisible="not is_medical_consumables">
                    <group>
                        <group>
                            <field name="ybbm"/>
                            <field name="purchase_type"/>
                            <field name="purchase_style"/>
                        </group>
                        <group string="注册信息">
                            <field name="registration_number"/>
                            <field name="registration_start_date"/>
                            <field name="registration_validity_period"/>
                        </group>
                        <group>
                            <field name="product_origin"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="product_template_search_view" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="ggxh" filter_domain="[('ggxh', 'ilike', self)]"/>
            </xpath>
            <field name="categ_id" position="after">
                <field name="ybbm"/>
                <field name="registration_number"/>
            </field>
            <xpath expr="//filter[@name='filter_to_purchase']" position="after">
                <filter string="医用耗材" name="filter_to_medical_consumables" domain="[('is_medical_consumables', '=', True)]"/>
            </xpath>
            <xpath expr="//filter[@name='categ_id']" position="after">
                <filter string="产品来源" name="filter_product_origin" context="{'group_by': 'product_origin'}"/>
                <filter string="采购类型" name="filter_purchase_type" context="{'group_by': 'purchase_type'}"/>
                <filter string="采购方式" name="filter_purchase_style" context="{'group_by': 'purchase_style'}"/>
            </xpath>
        </field>
    </record>

        <record id="product_product_tree_view" model="ir.ui.view">
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_product_tree_view"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="ggxh" optional="hide"/>
                    <field name="manufacturer_id" optional="hide"/>
                </field>
            </field>
        </record>
</odoo>
