<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record model="ir.ui.view" id="stock_request_order_search">
        <field name="model">stock.request.order</field>
        <field name="inherit_id" ref="stock_request.stock_request_order_search"/>
        <field name="arch" type="xml">
            <filter name="cancel" position="after">
                <separator/>
                <filter name="needs_review" string="需要我审核"
                        domain="[('reviewer_ids','in',uid), ('state', 'not in', ['done', 'cancel'])]"
                        help="待我审核的库存申请"/>
                <filter name="tier_validated" string="已批准"
                        domain="[('validated', '=', True)]"
                        help="已批准且准备好确认的库存申请"/>
            </filter>
        </field>
    </record>

</odoo>
