<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_request_tree" model="ir.ui.view">
        <field name="inherit_id" ref="stock_request.view_stock_request_tree" />
        <field name="model">stock.request</field>
        <field name="arch" type="xml">
            <data>
                <field name="name" position="before">
                    <header>
                        <button name="request_validation"
                                string="Request Validation"
                                t-attf-invisible="not need_validation or rejected or hide_reviews"
                                type="object"
                            />
                    </header>
                </field>
            </data>
        </field>
    </record>
</odoo>