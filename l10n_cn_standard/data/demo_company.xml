<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="partner_demo_company_cn" model="res.partner">
        <field name="name">演示公司</field>
        <field name="vat"/>
        <field name="street">江北区圣人路鲁能星城十二街区</field>
        <field name="city">重庆</field>
        <field name="country_id" ref="base.cn"/>
        <field name="state_id" ref="base.state_cn_CQ"/>
        <field name="zip">400025</field>
        <field name="phone">+86 123 2345 6789</field>
        <field name="email">info@company.example.com</field>
        <field name="website">www.example.com</field>
    </record>

    <record id="demo_company_cn" model="res.company">
        <field name="name">演示公司</field>
        <field name="partner_id" ref="partner_demo_company_cn"/>
    </record>

    <function model="res.company" name="_onchange_country_id">
        <value eval="[ref('demo_company_cn')]"/>
    </function>

    <function model="res.users" name="write">
        <value eval="[ref('base.user_root'), ref('base.user_admin'), ref('base.user_demo')]"/>
        <value eval="{'company_ids': [(4, ref('l10n_cn_standard.demo_company_cn'))]}"/>
    </function>

    <function model="account.chart.template" name="try_loading">
        <value eval="[]"/>
        <value>cn_standard</value>
        <value model="res.company" eval="obj().env.ref('l10n_cn_standard.demo_company_cn')"/>
    </function>
</odoo>
