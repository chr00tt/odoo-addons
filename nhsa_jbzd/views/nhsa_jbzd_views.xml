<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="view_nhsa_jbzd_tree">
        <field name="name">nhsa.jbzd.tree</field>
        <field name="model">nhsa.jbzd</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="master_code"/>
                <field name="name"/>
                <field name="category"/>
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_nhsa_jbzd">
        <field name="name">手术操作代码</field>
        <field name="res_model">nhsa.jbzd</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
