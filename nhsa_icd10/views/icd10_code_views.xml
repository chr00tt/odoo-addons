<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ICD-10 代码列表视图 -->
    <record id="view_icd10_code_tree" model="ir.ui.view">
        <field name="name">icd10.code.tree</field>
        <field name="model">icd10.code</field>
        <field name="arch" type="xml">
            <tree string="诊断代码列表">
                <field name="code"/>
                <field name="name"/>
                <field name="category_id"/>
            </tree>
        </field>
    </record>

    <!-- ICD-10 代码表单视图 -->
    <record id="view_icd10_code_form" model="ir.ui.view">
        <field name="name">icd10.code.form</field>
        <field name="model">icd10.code</field>
        <field name="arch" type="xml">
            <form string="诊断代码">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="category_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ICD-10 代码搜索视图 -->
    <record id="view_icd10_code_search" model="ir.ui.view">
        <field name="name">icd10.code.search</field>
        <field name="model">icd10.code</field>
        <field name="arch" type="xml">
            <search string="诊断代码">
                <field name="code" string="诊断代码"/>
                <field name="name" string="名称"/>
                <field name="category_id" string="分类"/>
                <searchpanel>
                    <field name="category_id" enable_counters="1" limit="0"/>
                </searchpanel>
                <group string="分组">
                    <filter name="group_by_category" string="分类" context="{'group_by':'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ICD-10 代码动作 -->
    <record id="icd10_code_action" model="ir.actions.act_window">
        <field name="name">ICD-10 诊断代码</field>
        <field name="res_model">icd10.code</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
