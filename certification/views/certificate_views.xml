<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="certificate_form" model="ir.ui.view">
        <field name="name">certificate.form</field>
        <field name="model">certificate</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="res_model" invisible="True"/>
                    <label for="name"/>
                    <h1>
                        <field name="name" readonly="not datas and type != 'url'"/>
                    </h1>
                    <group>
                        <field name="certificate_type_id"/>
                        <field name="certificate_number"/>
                        <field name="issue_date"/>
                        <field name="expiry_date"/>
                    </group>
                    <group>
                        <field name="type" readonly="datas or id" class="oe_inline"/>
                        <field name="datas"
                               filename="name"
                               invisible="type == 'url'"
                               required="type == 'binary'"
                               class="oe_inline"/>
                        <field name="url" widget="url" invisible="type == 'binary'" required="type == 'url'"/>
                    </group>
                    <group string="附加于" groups="base.group_no_one">
                        <field name="res_name"/>
                        <field name="company_id"
                               groups="base.group_multi_company"
                               options="{'no_create': True}"
                               class="oe_inline"/>
                    </group>
                    <group string="历史" groups="base.group_no_one" invisible="not create_date">
                        <label for="create_uid" string="创建"/>
                        <div name="creation_div">
                            <field name="create_uid" readonly="1" class="oe_inline"/> on
                            <field name="create_date" readonly="1" class="oe_inline"/>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="certificate_kanban" model="ir.ui.view">
        <field name="name">certificate.kanban</field>
        <field name="model">certificate</field>
        <field name="arch" type="xml">
            <kanban js_class="certificates_kanban">
                <field name="ir_attachment_id"/>
                <field name="mimetype"/>
                <field name="type"/>
                <field name="name"/>
                <field name="create_uid"/>
                <field name="active"/>
                <templates>
                    <t t-name="kanban-menu">
                        <a t-if="widget.editable" type="edit" class="dropdown-item">编辑</a>
                        <a t-if="widget.deletable" type="delete" class="dropdown-item">删除</a>
                        <a t-attf-href="/web/content/#{record.ir_attachment_id.raw_value}?download=true" download="" class="dropdown-item">下载</a>
                    </t>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <field name="res_model" invisible="True"/>
                            <div class="o_kanban_record_top mb16">
                                <div class="o_kanban_record_headings ms-1">
                                    <strong class="o_kanban_record_title"><span><t t-esc="record.name.value"/></span></strong>
                                </div>
                                <strong><field name="certificate_type_id"/></strong>
                            </div>
                            <div class="o_kanban_details">
                                <div class="o_kanban_record_body"
                                        name="body"
                                        t-if="record.type.raw_value == 'url'">
                                    <field name="url" widget="url" invisible="type == 'binary'"/>
                                </div>
                            </div>
                            <div>
                                <span>证书编号:</span>
                                <field name="certificate_number"/>
                            </div>
                            <div>
                                <span>发证日期:</span>
                                <field name="issue_date" widget="date"/>
                            </div>
                            <div>
                                <span>到期日期:</span>
                                <field name="expiry_date" widget="date"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="certificate_list" model="ir.ui.view">
        <field name="name">certificate.list</field>
        <field name="model">certificate</field>
        <field name="arch" type="xml">
            <tree>
                <field name="res_name"/>
                <field name="name"/>
                <field name="certificate_type_id"/>
                <field name="certificate_number"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
            </tree>
        </field>
    </record>

    <record id="certificate_search" model="ir.ui.view">
        <field name="name">certificate.search</field>
        <field name="model">certificate</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="certificate_number"/>
                <filter name="expiry_date" date="expiry_date" string="到期日期"/>
                <group expand="0">
                    <filter name="certificate_type_id" string="资质类型" context="{'group_by': 'certificate_type_id'}"/>
                    <filter name="expiry_date" string="到期日期" context="{'group_by': 'expiry_date'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
